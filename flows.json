    {
        "id": "4b630cb1d389a8be",
        "type": "function",
        "z": "2ecc35e7569d3903",
        "name": "Логіка керування",
        "func": "\nif (msg.topic === \"mode\") { flow.set(\"mode\", msg.payload); return null; }\nif (msg.topic === \"lamp\") { flow.set(\"manual_lamp\", msg.payload); return null; }\n\nif (msg.topic === \"greenhouse/lux\") {\n    let lux = msg.payload;\n    let mode = flow.get(\"mode\") || false;\n    let manualLamp = flow.get(\"manual_lamp\") || false;\n    let lampStatus = mode ? manualLamp : (lux < 3000);\n    \n\n    let statusText = lampStatus ? \"увімкнено\" : \"вимкнено\";\n    \n    let gpioSignal = lampStatus ? 1 : 0;\n    \n\n    let sheetData = {\n        lux: lux,\n        status: statusText,\n        time: new Date().toLocaleString()\n    };\n\n    return [\n        { payload: statusText },\n        { payload: gpioSignal },\n        { payload: sheetData } \n    ];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 320,
        "wires": [
