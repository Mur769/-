    {
        "id": "333cf852920a0782",
        "type": "function",
        "z": "2ecc35e7569d3903",
        "name": "Емуляція датчика BH1750",
        "func": "\nlet currentLux = context.get('lux') || 6000;\n\ncurrentLux += Math.floor(Math.random() * 500) - 300;\nif (currentLux < 3000) currentLux = 3000;\nif (currentLux > 12000) currentLux = 12000;\n\ncontext.set('lux', currentLux);\n\nmsg.topic = \"teplyca/lux\"; \nmsg.payload = currentLux;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
